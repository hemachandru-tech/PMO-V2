{
  "name": "@tela/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "tokens": "node scripts/gen-tokens.mjs",
    "openapi": "cd ../.. && uv run python -m tela_api.openapi_export apps/web/src/api/openapi.json",
    "bundle:check": "vite build --manifest && node scripts/check-bundle.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@hookform/resolvers": "5.9.1",
    "@lezer/highlight": "1.2.5",
    "@observablehq/plot": "0.6.17",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.62.7",
    "@tanstack/react-table": "9.2.6",
    "@tanstack/react-virtual": "3.14.13",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "d3-force": "3.0.0",
    "d3-scale": "4.0.2",
    "d3-shape": "3.2.0",
    "echarts": "5.5.1",
    "js-yaml": "4.3.2",
    "lucide-react": "1.52.0",
    "motion": "14.0.0",
    "oidc-client-ts": "3.1.0",
    "radix-ui": "1.6.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-grid-layout": "1.5.0",
    "react-hook-form": "7.89.0",
    "react-is": "18.3.1",
    "react-router-dom": "6.28.0",
    "recharts": "3.10.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.5"
