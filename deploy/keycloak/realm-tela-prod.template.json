{
  "realm": "tela",
  "displayName": "Tela",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 28800,
  "ssoSessionMaxLifespan": 86400,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "clients": [
    {
      "clientId": "tela-web",
      "name": "Tela web app",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "${TELA_WEB_ORIGIN}/auth/callback"
      ],
      "webOrigins": [
        "${TELA_WEB_ORIGIN}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${TELA_WEB_ORIGIN}/"
      },
      "protocolMappers": [
        {
          "name": "tela-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "tela-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "entra-groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "entra_groups",
            "claim.name": "groups",
            "jsonType.label": "String",
            "multivalued": "true",
            "aggregate.attrs": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "entra-tid",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "entra_tid",
            "claim.name": "tid",
            "jsonType.label": "String",
            "multivalued": "false",
            "aggregate.attrs": "false",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "entra-oid",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "entra_oid",
            "claim.name": "oid",
            "jsonType.label": "String",
            "multivalued": "false",
            "aggregate.attrs": "false",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "identityProviders": [
    {
      "alias": "entra",
      "displayName": "Microsoft Entra ID",
      "providerId": "oidc",
      "enabled": true,
      "trustEmail": false,
      "storeToken": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "authorizationUrl": "https://login.microsoftonline.com/${ENTRA_TENANT_ID}/oauth2/v2.0/authorize",
        "tokenUrl": "https://login.microsoftonline.com/${ENTRA_TENANT_ID}/oauth2/v2.0/token",
        "jwksUrl": "https://login.microsoftonline.com/${ENTRA_TENANT_ID}/discovery/v2.0/keys",
        "issuer": "https://login.microsoftonline.com/${ENTRA_TENANT_ID}/v2.0",
        "logoutUrl": "https://login.microsoftonline.com/${ENTRA_TENANT_ID}/oauth2/v2.0/logout",
        "validateSignature": "true",
        "useJwksUrl": "true",
        "pkceEnabled": "true",
        "pkceMethod": "S256",
        "clientAuthMethod": "client_secret_post",
        "clientId": "${ENTRA_CLIENT_ID}",
        "clientSecret": "${ENTRA_CLIENT_SECRET}",
        "defaultScope": "openid profile email",
        "syncMode": "FORCE"
      }
    }
  ],
  "identityProviderMappers": [
    {
      "name": "groups",
      "identityProviderAlias": "entra",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "claim": "groups",
        "user.attribute": "entra_groups",
        "syncMode": "FORCE"
      }
    },
    {
      "name": "tid",
      "identityProviderAlias": "entra",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "claim": "tid",
        "user.attribute": "entra_tid",
        "syncMode": "FORCE"
      }
    },
    {
      "name": "oid",
      "identityProviderAlias": "entra",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "claim": "oid",
        "user.attribute": "entra_oid",
        "syncMode": "FORCE"
      }
    }
  ],
  "browserFlow": "browser"
}